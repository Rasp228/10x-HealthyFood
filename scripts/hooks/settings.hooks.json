{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/scripts/hooks/lint-edited-file.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/scripts/hooks/related-tests.mjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
