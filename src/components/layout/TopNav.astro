---
// Plik komponentu TopNav.astro
import ThemeToggle from "./ThemeToggle";
import LogoutButton from "../common/LogoutButton";
import { buttonVariants } from "../ui/button";

const links = [
  { href: "/", label: "Strona Główna" },
  { href: "/diary", label: "Dziennik" },
  { href: "/profile", label: "Profil" },
];

// Ścieżka bez końcowego ukośnika, żeby "/diary/" też wskazywało Dziennik.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="border-b">
  <!-- Poniżej `sm` linki schodzą do drugiej linii (`order-last`) i przewijają się same, nie cała
       strona. "Wyloguj" stoi przy przełączniku motywu, więc na telefonie zawsze jest na ekranie.
       Kolejność w DOM to kolejność desktopu - po niej idzie Tab. -->
  <div class="container mx-auto flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:h-16 sm:flex-nowrap sm:py-0">
    <a href="/" class="flex items-center font-bold text-xl">
      <span class="text-primary">Healthy</span>
      <span>Meal</span>
    </a>
    <nav class="order-last flex w-full min-w-0 items-center gap-2 overflow-x-auto p-1 sm:order-none sm:w-auto sm:gap-4 sm:overflow-visible sm:p-0">
      {links.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <a
            href={href}
            aria-current={active ? "page" : undefined}
            class={buttonVariants({ variant: active ? "default" : "outline" })}
          >
            {label}
          </a>
        );
      })}
    </nav>
    <div class="ml-auto flex items-center gap-2 sm:gap-4">
      <ThemeToggle client:load />
      <button id="logout-button" class={buttonVariants({ variant: "outline" })}>
        Wyloguj
      </button>
    </div>
  </div>
</header>

<LogoutButton client:load />
