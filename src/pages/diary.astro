---
import MainLayout from "../layouts/MainLayout.astro";
import DiaryPage from "../components/diary/DiaryPage";
import SecurityGuard from "../components/common/SecurityGuard";
import { UserSettingsService } from "../lib/services/user-settings.service";
import { logError } from "../lib/utils/log";

// Cel czytamy na serwerze, żeby pasek był w pierwszym renderze wyspy. Błąd odczytu nie może
// zablokować dziennika - strona rysuje się bez paska, ale z flagą `goalError`, żeby podsumowanie
// dnia powiedziało o awarii zamiast udawać, że celu nie ustawiono.
// Bez `prerender = true`: strona czyta `locals.user`.
const { user, requestId } = Astro.locals;
let dailyGoal: number | null = null;
let goalError = false;

if (user) {
  try {
    dailyGoal = await new UserSettingsService(Astro.locals.supabase).getDailyGoal(user.id);
  } catch (error) {
    goalError = true;
    logError("diary.goal_read_failed", { requestId, userId: user.id }, error);
  }
}
---

<MainLayout title="HealthyMeal - Dziennik posiłków">
  <SecurityGuard client:load />
  <DiaryPage client:load dailyGoal={dailyGoal} goalError={goalError} />
</MainLayout>
