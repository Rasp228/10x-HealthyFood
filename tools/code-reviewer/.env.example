# Copy to .env (gitignored) and fill in.

# local (llama.cpp server, default) | openrouter
REVIEW_PROVIDER=local

# Optional. Model id; defaults to "local" for llama.cpp and anthropic/claude-sonnet-5.5 for OpenRouter.
REVIEW_MODEL=

# Optional. llama-server's OpenAI-compatible endpoint; defaults to http://localhost:8080/v1.
LLAMACPP_BASE_URL=

# Required only when REVIEW_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Optional. Hard budget cap per review run in USD; defaults to 0.10. Ignored when the provider reports no cost.
REVIEW_MAX_COST_USD=
