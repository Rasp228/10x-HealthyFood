# Copy to .env (gitignored) and fill in.

# local (llama.cpp server, default) | openrouter
REVIEW_PROVIDER=local

# Optional. Model id; defaults to "local" for llama.cpp and anthropic/claude-sonnet-5.5 for OpenRouter.
REVIEW_MODEL=

# Optional. llama-server's OpenAI-compatible endpoint; defaults to http://localhost:8080/v1.
LLAMACPP_BASE_URL=

# Required only when REVIEW_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Optional. Budget per review run in USD; defaults to 0.10. Over it the CLI exits 2. Ignored when the provider reports no cost.
REVIEW_MAX_COST_USD=

# Optional. Output token cap per call, reasoning included; defaults to 32768 for local and 8192 for openrouter.
REVIEW_MAX_OUTPUT_TOKENS=

# Optional. Timeout of a whole review run in ms; defaults to 600000 for local and 120000 for openrouter.
REVIEW_TIMEOUT_MS=

# Optional. 1 = review data/sample.diff when stdin is empty; otherwise empty stdin is an error.
# Better set per run (REVIEW_SAMPLE=1 npm run review < /dev/null) than here.
REVIEW_SAMPLE=

# Optional. Largest diff sent to the model, in bytes; defaults to 100000. A larger diff fails before any request.
REVIEW_MAX_DIFF_BYTES=
