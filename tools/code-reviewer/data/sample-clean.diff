-export function remainingCalories(goal: number, entries: DiaryEntry[]): number {
+// A missing goal (no user_settings row, or daily_calorie_goal = null) leaves nothing to count
+// down from: null lets the view hide the counter instead of showing a made-up number.
+export function remainingCalories(goal: number | null, entries: DiaryEntry[]): number | null {
+  if (goal === null) return null;
   return Math.max(goal - sumCalories(entries), 0);
 }
diff --git a/tests/unit/calories.test.ts b/tests/unit/calories.test.ts
new file mode 100644
index 0000000..7d4e1a9
--- /dev/null
+++ b/tests/unit/calories.test.ts
@@ -0,0 +1,31 @@
+import { remainingCalories, sumCalories } from "@/lib/utils/calories";
+
+const entries = [
+  { name: "Owsianka", calories: 350 },
+  { name: "Zupa (czeka na szacunek)", calories: null },
+  { name: "Kanapka", calories: 420 },
+];
+
+describe("sumCalories", () => {
+  it("liczy wpis bez kalorii jako 0", () => {
+    expect(sumCalories(entries)).toBe(770);
+  });
+
+  it("zwraca 0 dla pustego dnia", () => {
+    expect(sumCalories([])).toBe(0);
+  });
+});
+
+describe("remainingCalories", () => {
+  it("odejmuje zjedzone kalorie od celu", () => {
+    expect(remainingCalories(2000, entries)).toBe(1230);
+  });
+
+  it("nie schodzi poniżej 0 po przekroczeniu celu", () => {
+    expect(remainingCalories(500, entries)).toBe(0);
+  });
+
+  it("zwraca null, gdy cel nie jest ustawiony", () => {
+    expect(remainingCalories(null, entries)).toBeNull();
+  });
+});
