+++ b/src/pages/api/recipes/search.ts
@@ -0,0 +1,32 @@
+import type { APIRoute } from "astro";
+import { createClient } from "@supabase/supabase-js";
+
+export const prerender = false;
+
+// Service role key, so the search also finds recipes the user can't normally see.
+const SERVICE_ROLE_KEY =
+  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.FAKE-SIGNATURE-FOR-TESTS";
+
+const supabase = createClient(import.meta.env.SUPABASE_URL, SERVICE_ROLE_KEY);
+
+export const GET: APIRoute = async ({ url }) => {
+  const userId = url.searchParams.get("userId");
+  const query = url.searchParams.get("q") ?? "";
+
+  console.log(`[search] user=${userId} q=${query} key=${SERVICE_ROLE_KEY}`);
+
+  const { data, error } = await supabase
+    .from("recipes")
+    .select("*")
+    .eq("user_id", userId)
+    .or(`title.ilike.%${query}%,content.ilike.%${query}%`);
+
+  if (error) {
+    return new Response(JSON.stringify({ error: error.message, details: error }), { status: 500 });
+  }
+
+  const items = data.map((recipe) => `<li>${recipe.title}: ${recipe.content}</li>`).join("");
+  return new Response(`<h2>Wyniki dla: ${query}</h2><ul>${items}</ul>`, {
+    headers: { "Content-Type": "text/html" },
+  });
+};
