{
  // Bramka bezpieczeństwa dla `npm run test:security`.
  // Wywraca się na wszystkim od poziomu "moderate" w górę.
  "moderate": true,

  // Znane advisory, których nie da się dziś zamknąć.
  //
  // GHSA-9wv6-86v2-598j (path-to-regexp, high) przychodzi tranzytywnie przez
  // @vercel/routing-utils w @astrojs/vercel. Adapter jest już w najnowszej wersji,
  // a `npm audit fix --force` proponuje cofnięcie do @astrojs/vercel@8.0.4, co zabrałoby
  // łatkę CVE `x-astro-path` i wymusiłoby powrót do Astro 5. Przeglądać przy każdym
  // bumpie @astrojs/vercel. Stan na 2026-10-27 (@astrojs/vercel 11.0.12).
  //
  // GHSA-mrhx-c7xc-m3w5 (zod, high) - tylko dla ścieżki przez adapter Vercela:
  // @astrojs/vercel > @vercel/functions > @vercel/oidc > @vercel/cli-config, który przypina
  // zod dokładnie na 4.1.11 (także w najnowszym 0.3.4), więc łatki nie ma. cli-config parsuje
  // lokalny config Vercela, nie dane od użytkownika. Bezpośredni zod jest załatany (>= 4.6.6) i
  // ten wpis go nie obejmuje. Override zostawiamy - zmieniłby zawartość funkcji Vercel (lekcja
  // z 2026-10-09). Przeglądać przy każdym bumpie @astrojs/vercel / @vercel/cli-config.
  // Stan na 2026-10-27.
  //
  // GHSA-vfj7-8cjw-p6xm (braces) i GHSA-hp3w-g68c-fv3c (sprintf-js) usunięte 2026-10-27:
  // nie ma ich już w drzewie zależności (audit-ci: "Consider not allowlisting").
  //
  // Każdy wpis ma `expiry`: po tej dacie przestaje działać i bramka znów się wywraca. To
  // wymusza przegląd, nawet gdy nikt nie podbijał zależności - łatka mogła już wyjść. Przy
  // przeglądzie: sprawdź, czy jest wersja bez podatności (`npm view <pakiet> version`); jeśli
  // jest - podbij i usuń wpis, jeśli nie - przesuń `expiry` o 3 miesiące i zaktualizuj „Stan na”.
  "allowlist": [
    {
      "GHSA-9wv6-86v2-598j": {
        "active": true,
        "expiry": "2027-01-06",
        "notes": "path-to-regexp przez @astrojs/vercel"
      }
    },
    {
      "GHSA-mrhx-c7xc-m3w5|@astrojs/vercel>@vercel/functions>@vercel/oidc>@vercel/cli-config>zod": {
        "active": true,
        "expiry": "2027-01-27",
        "notes": "zod 4.1.11 przypięty w @vercel/cli-config, brak łatki"
      }
    }
  ]
}
